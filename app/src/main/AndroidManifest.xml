<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Android 11+ package visibility:
         required so PackageManager can detect installed wallet apps
         and so we can build package-targeted VIEW intents. -->
    <queries>
        <!-- MetaMask (both package IDs seen in the wild) -->
        <package android:name="io.metamask" />
        <package android:name="io.metamask.ethereum" />
        <!-- Trust Wallet (newer + legacy package IDs) -->
        <package android:name="com.walletconnect.trustwallet" />
        <package android:name="com.wallet.crypto.trustapp" />

        <!-- Generic scheme visibility (so we can ask the system to resolve
             metamask:// / trust:// without targeting a specific package). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="metamask" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="trust" />
        </intent>

        <!-- Universal-link visibility -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="metamask.app.link" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="link.trustwallet.com" />
        </intent>

        <!-- Play Store fallback -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".AetherDexApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:replace="android:dataExtractionRules,android:fullBackupContent">
        <!--
            Reown 1.0.0's AAR ships its own android:dataExtractionRules
            (and fullBackupContent) on <application>. tools:replace tells the
            manifest merger to drop the AAR's value and keep ours.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">

            <!-- Standard launcher entry -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- AppKit / WalletConnect redirect: com.aetherdex.app://wc -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.aetherdex.app" />
            </intent-filter>

        </activity>

        <!-- Trust Wallet–style Receive / Deposit screen -->
        <activity
            android:name=".ReceiveActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
