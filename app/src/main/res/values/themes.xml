<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- AetherDex dark trading theme.
         The whole product is dark, so light + night share the same tokens. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Material 3 color tokens -->
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/brand_green_dim</item>
        <item name="colorOnPrimaryContainer">@color/brand_green</item>

        <item name="colorSecondary">@color/brand_red</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorTertiary">@color/brand_green</item>
        <item name="colorOnTertiary">@color/black</item>

        <item name="android:colorBackground">@color/bg_root</item>
        <item name="colorSurface">@color/bg_panel</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/bg_panel_alt</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

    <style name="ThemeOverlay.AetherDex.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:colorBackground">@color/bg_root</item>
        <item name="colorSurface">@color/bg_root</item>
        <item name="bottomSheetStyle">@style/Widget.AetherDex.BottomSheet</item>
    </style>

    <style name="Widget.AetherDex.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/bg_root</item>
        <item name="shapeAppearance">@style/ShapeAppearance.AetherDex.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.AetherDex.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Widget styles -->
    <style name="Widget.AetherDex.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_panel</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.AetherDex.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">999dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/transparent</item>
    </style>

    <style name="TextAppearance.AetherDex.SectionTitle" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.AetherDex.Price" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AetherDex.Change" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/brand_green</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AetherDex.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.AetherDex.Value" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
