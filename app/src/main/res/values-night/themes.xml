<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- AetherDex is always dark; night variant uses the same tokens as day. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/brand_green_dim</item>
        <item name="colorOnPrimaryContainer">@color/brand_green</item>

        <item name="colorSecondary">@color/brand_red</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/bg_root</item>
        <item name="colorSurface">@color/bg_panel</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/bg_panel_alt</item>
        <item name="colorOutline">@color/divider</item>

        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
    </style>
</resources>
